# Kopieren nach ".env" und mit echten Werten fuellen. ".env" ist in .gitignore
# und darf NIEMALS committet werden.
#
# Coinbase Advanced Trade Cloud API Key (siehe README.md fuer die genauen Schritte,
# um einen Key mit NUR "View" + "Trade" Rechten zu erstellen, OHNE "Transfer"/Withdraw).
COINBASE_API_KEY=organizations/xxxxxxxx/apiKeys/xxxxxxxx
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEE...\n-----END EC PRIVATE KEY-----\n"

# Nur noetig, wenn growth_notify.enabled=true in config.yaml.
# Bot bei @BotFather in Telegram anlegen (/newbot), Token hier eintragen.
# Chat-ID: dem eigenen Bot eine Nachricht schicken, dann
# https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen und "chat":{"id":...} ablesen.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789
